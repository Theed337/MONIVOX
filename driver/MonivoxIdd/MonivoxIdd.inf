;
; MonivoxIdd.inf – Monivox Indirect Display Driver
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=MonivoxIdd.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
; Software-Gerät, angelegt vom MonivoxDevice-Tool (SwDeviceCreate)
%DeviceName%=Monivox_Install, MonivoxIdd
; Alternativ root-enumeriert (z. B. mit devcon install)
%DeviceName%=Monivox_Install, Root\MonivoxIdd

[SourceDisksFiles]
MonivoxIdd.dll=1

[SourceDisksNames]
1=%DiskName%

[Monivox_Install.NT]
CopyFiles=UMDriverCopy

[Monivox_Install.NT.hw]
AddReg=Monivox_HardwareDeviceSettings

[Monivox_HardwareDeviceSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"MonivoxGroup"

[Monivox_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[Monivox_Install.NT.Wdf]
UmdfService=MonivoxIdd,MonivoxIdd_Install
UmdfServiceOrder=MonivoxIdd
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[MonivoxIdd_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\MonivoxIdd.dll
UmdfExtensions=IddCx0102

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=13

[UMDriverCopy]
MonivoxIdd.dll

[Strings]
ManufacturerName="Monivox"
DiskName="Monivox Installationsmedium"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="Monivox Virtual Display Adapter"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
