<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MONIVOX</AssemblyName>
    <RootNamespace>Monivox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms wird nur für das Tray-Symbol gebraucht; Namenskonflikte vermeiden -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Monivox.Windows\Monivox.Windows.csproj" />
  </ItemGroup>
</Project>
